# Helix environment (never commit real secrets)

# API
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://helix:helix@localhost:5432/helix
# Used to sign session tokens in later phases. Generate a long random string.
AUTH_SECRET=replace-me-with-a-long-random-string

# AI — leave empty / none to run without a vendor
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Mobile (public)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Observability (optional)
SENTRY_DSN=
